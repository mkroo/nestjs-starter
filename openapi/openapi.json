                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "PostgreSQL is unavailable or the application is shutting down",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "error",
                    "info": {},
                    "error": {
                      "postgres": {
                        "status": "down"
                      }
                    },
                    "details": {
